# Windowsのサムネイルキャッシュ
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# ダンプファイル
*.stackdump

# フォルダの設定ファイル
[Dd]esktop.ini

# ファイル共有で使用されるごみ箱
$RECYCLE.BIN/

# Windowsのインストーラーファイル
*.cab
*.msi
*.msix
*.msm
*.msp

